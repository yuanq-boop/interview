ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Chrome channel Playwright launches.
# Default is "chrome" (your system-installed Chrome, kept for a persistent profile).
# Set to "chromium" to use Playwright's bundled Chromium instead.
# CRITIC_CHROME_CHANNEL=chromium

# Optional: point at a specific Chrome/Chromium binary directly, bypassing
# channel resolution entirely (useful in sandboxed/CI environments with a
# non-standard browser install location).
# CRITIC_CHROME_EXECUTABLE=/path/to/chrome
